{
  "name": "c2c_images",
  "version": "1.7.3",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node ./dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "prettier --check . && eslint . && tsc",
    "test": "vitest run --project base --project nofile --project options",
    "test:all": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit/js-results.xml",
    "clean:incoming": "node ./dist/scripts/clean.js",
    "prepare": "husky",
    "preversion": "npm run build && npm run lint && npm run test",
    "postversion": "git push --follow-tags --no-verify",
    "test:watch": "vitest --project base --project nofile --project options",
    "lint:fix": "prettier --write . && eslint --fix ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c2corg/c2c_images.git"
  },
  "author": "",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/c2corg/c2c_images/issues",
    "email": "dev@camptocamp.org"
  },
  "homepage": "https://www.camptocamp.org",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/async": "3.2.24",
    "@types/command-exists": "1.2.3",
    "@types/cors": "2.8.19",
    "@types/cross-spawn": "6.0.6",
    "@types/debug": "4.1.12",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "image-size": "1.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1032.0",
    "async": "3.2.6",
    "command-exists": "1.2.9",
    "cors": "2.8.6",
    "cross-spawn": "7.0.3",
    "debug": "4.3.7",
    "express": "5.3.0",
    "http-errors": "2.0.1",
    "multer": "2.5.0",
    "prom-client": "15.1.3",
    "sanitize-filename": "1.6.3",
    "yn": "5.0.0",
    "zod": "4.6.7"
  }
}
